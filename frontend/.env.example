# Frontend build settings. Copy to frontend/.env.production (git-ignored) for
# the production build. Unset, the app calls http://<this host>:8000/api.
#
# Production must use HTTPS so card-payment redirects and sign-in tokens
# never travel over plain HTTP.
VITE_API_BASE=https://api.example.lk/api

# Phase 2 only (Amadeus). Leave unset for the Phase 1 go-live.
# VITE_AMADEUS_API_BASE=https://amadeus-api.example.lk/api
