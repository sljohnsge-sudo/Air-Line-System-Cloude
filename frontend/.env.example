# Frontend build settings. Copy to frontend/.env.production (git-ignored) for
# the production build. Unset, the app calls http://<this host>:8005/api.
#
# Production must use HTTPS so card-payment redirects and sign-in tokens
# never travel over plain HTTP.
VITE_API_BASE=https://api.example.lk/api

# Phase 2 only (Amadeus). Leave unset for the Phase 1 go-live.
# VITE_AMADEUS_API_BASE=https://amadeus-api.example.lk/api

# Public website address (no trailing slash), e.g. https://www.tickandbook.lk
# Used for shared fare links and the WhatsApp/Facebook link-preview image.
VITE_PUBLIC_SITE_URL=

# Tick and Book's own customer contact details, shown on e-tickets and support
# notes (each only when set). Never George Steuart Travel's details.
VITE_SUPPORT_PHONE=
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_ADDRESS=
