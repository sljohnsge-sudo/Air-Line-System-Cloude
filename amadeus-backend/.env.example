# ============================================================
# AMADEUS FOR DEVELOPERS — TEST (SANDBOX) CREDENTIALS
# Copy this file to .env and fill in real values.
# DO NOT COMMIT .env TO VERSION CONTROL
# ============================================================

# OAuth2 token endpoint + API base (test environment)
AMADEUS_AUTH_URL=https://test.api.amadeus.com/v1/security/oauth2/token
AMADEUS_API_BASE=https://test.api.amadeus.com

# Client credentials from the Amadeus for Developers self-service app
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# MySQL (own database, isolated from the Travelport system)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=amadeus_system
