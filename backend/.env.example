# ─────────────────────────────────────────────────────────────────────────────
# Backend settings template. Copy to backend/.env and fill in. NEVER commit .env.
# Values below are the PRODUCTION shape; pre-production uses the .pp. hosts.
# GET /api/admin/go-live-checks (and the startup log) flags anything not ready.
# ─────────────────────────────────────────────────────────────────────────────

# ── Travelport TripServices Flights ─────────────────────────────────────────
# Pre-production: https://auth.pp.travelport.net/oauth/token, https://api.pp.travelport.net
TP_AUTH_URL=https://auth.travelport.net/oauth/token
TP_API_BASE=https://api.travelport.net
TP_API_VERSION=11
TP_USERNAME=
TP_PASSWORD=
TP_CLIENT_ID=
TP_CLIENT_SECRET=
TP_PCC=
TP_ACCESS_GROUP=
TP_CURRENCY=LKR
# Search options (defaults shown)
TP_CONTENT_SOURCES=GDS,NDC
TP_OFFERS_PER_PAGE=999
TP_MAX_UPSELLS=4

# Agency details sent on GDS bookings (Add Travel Agency)
TP_AGENCY_NAME=
TP_AGENCY_ADDRESS_LINE=
TP_AGENCY_CITY=
TP_AGENCY_POSTAL_CODE=
TP_AGENCY_COUNTRY=LK
TP_AGENCY_CORPORATE_CODE=
TP_AGENCY_PHONE_COUNTRY_CODE=94
TP_AGENCY_PHONE_AREA_CODE=
TP_AGENCY_PHONE_NUMBER=
TP_AGENCY_EMAIL=
# Agency local time as minutes from UTC (Sri Lanka = 330). A GDS ticket can be
# voided only on its issue date in agency time.
TP_AGENCY_UTC_OFFSET_MINUTES=330

# Request/response logs. Leave TP_LOG_DIR empty to log nothing. Logs are masked
# (tokens, client ids, passport numbers, birth dates, card data) unless
# TP_LOG_UNREDACTED=true — only for a one-off capture Travelport asks for.
# The log directory is git-ignored; never commit it.
TP_LOG_DIR=
TP_LOG_UNREDACTED=false

# ── Website / security ──────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API from a browser, e.g.
# https://book.georgesteuart.lk . Empty = localhost and private LAN only.
CORS_ALLOWED_ORIGINS=
FRONTEND_BASE_URL=
OAUTH_REDIRECT_BASE=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── Database ────────────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=final_travels_system

# ── PayCorp (Sampath) card payments ─────────────────────────────────────────
PAYCORP_ENDPOINT=
PAYCORP_AUTH_TOKEN=
PAYCORP_HMAC_SECRET=
PAYCORP_CLIENT_ID_LKR=
PAYCORP_CLIENT_ID_USD=

# ── ERP (ERPNext) invoices after ticketing ──────────────────────────────────
# No default host: leave empty to turn ERP sync off. Use the PRODUCTION ERP.
ERP_BASE_URL=
ERP_API_KEY=
ERP_API_SECRET=
ERP_COMPANY=
ERP_ITEM_CODE=
ERP_DEFAULT_CUSTOMER_GROUP=Individual
ERP_DEFAULT_TERRITORY=Sri Lanka

# ── Email (alerts, ticket share, visa desk) ─────────────────────────────────
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=
VISA_CONSULTANT_EMAIL=

# ── Customer sign-in with Google / Microsoft (optional) ─────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# ── Phase 2 modules (keep off for the Phase 1 go-live) ──────────────────────
# Amadeus flights are switched in the Admin Portal (Provider Control).
AMADEUS_BACKEND_URL=http://localhost:8002
# IndiGo via Travelport uAPI — routes return 503 unless true.
INDIGO_ENABLED=false
TP_UAPI_BASE_URL=
TP_UAPI_USERNAME=
TP_UAPI_PASSWORD=
TP_UAPI_TARGET_BRANCH=
TP_UAPI_GUARANTEE_CARD_HOLDER_NAME=
TP_UAPI_GUARANTEE_CARD_NUMBER=
TP_UAPI_GUARANTEE_CARD_TYPE=
TP_UAPI_GUARANTEE_CARD_EXPIRY=
TP_UAPI_GUARANTEE_CARD_CVV=
TP_UAPI_GUARANTEE_CARD_BILLING_COUNTRY=
TP_UAPI_GUARANTEE_CARD_BILLING_STATE=
TP_UAPI_GUARANTEE_CARD_BILLING_CITY=
TP_UAPI_GUARANTEE_CARD_BILLING_POSTAL=
TP_UAPI_GUARANTEE_CARD_BILLING_ADDRESS=

# Hotels via Travelport Stays (switched in the Admin Portal). The guarantee
# card must be the agency's REAL card — never a test card in production.
HOTEL_TP_AUTH_URL=https://auth.travelport.net/oauth/token
HOTEL_TP_API_BASE=https://api.travelport.net
HOTEL_TP_USERNAME=
HOTEL_TP_PASSWORD=
HOTEL_TP_CLIENT_ID=
HOTEL_TP_CLIENT_SECRET=
HOTEL_TP_PCC=
HOTEL_TP_ACCESS_GROUP=
HOTEL_DEFAULT_CURRENCY=USD
HOTEL_GUARANTEE_CARD_HOLDER_NAME=
HOTEL_GUARANTEE_CARD_NUMBER=
HOTEL_GUARANTEE_CARD_TYPE=
HOTEL_GUARANTEE_CARD_CODE=
HOTEL_GUARANTEE_CARD_EXPIRE=
HOTEL_GUARANTEE_CARD_CVV=
HOTEL_GUARANTEE_CARD_BILLING_COUNTRY=LK
HOTEL_GUARANTEE_CARD_BILLING_POSTAL=
HOTEL_GUARANTEE_CARD_BILLING_CITY=
HOTEL_GUARANTEE_CARD_BILLING_ADDRESS=
HOTEL_GUARANTEE_CARD_BILLING_STREET_NUMBER=
HOTEL_GUARANTEE_CARD_BILLING_STATE_PROV=
HOTEL_GUARANTEE_CARD_BILLING_COUNTY=
HOTEL_GUARANTEE_CARD_BILLING_PHONE_COUNTRY_CODE=
HOTEL_GUARANTEE_CARD_BILLING_PHONE_AREA_CODE=
HOTEL_GUARANTEE_CARD_BILLING_PHONE_NUMBER=
HOTEL_GUARANTEE_CARD_BILLING_EMAIL=
